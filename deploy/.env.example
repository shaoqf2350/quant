# =====================================================================
# QuantPF 部署环境变量模板（.env.example）
# ---------------------------------------------------------------
# 用法：cp .env.example .env 并填写全部占位值。
#   * 真实 .env 必须加入 .gitignore，禁止提交（含 S1 秘密凭据）；
#   * 本文件同时被 docker-compose.yml 的 ${VAR} 替换 与 Spring Boot
#     application-prod.yml 的同名环境变量解析 两处使用，请保持变量名一致。
# 秘密生成建议：openssl rand -base64 48
#            或 python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# ---------------- Docker Compose 项目 ----------------
COMPOSE_PROJECT_NAME=quantpf

# ---------------- MySQL（QuantPF 主库，schema=quantpf） ----------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=quantpf
MYSQL_USER=quantpf
MYSQL_PASSWORD=PLEASE_CHANGE_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=PLEASE_CHANGE_MYSQL_ROOT_PASSWORD

# ---------------- Redis（QuantPF 缓存 / 锁 / 发布订阅） ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=PLEASE_CHANGE_REDIS_PASSWORD

# ---------------- MinIO（对象存储：原始快照 / 附件 / Dify Dataset 副本） ----------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=quantpf
MINIO_ROOT_PASSWORD=PLEASE_CHANGE_MINIO_PASSWORD
MINIO_BUCKET=qpf-snapshots

# ---------------- 安全：Sa-Token JWT 签名密钥（>= 32 字节，生产必改） ----------------
# 注意：仓库默认值 abcdefghijklmnopqrstuvwxyz 不安全，必须替换
JWT_SECRET=PLEASE_CHANGE_JWT_SECRET_openssl_rand_base64_48

# ---------------- XXL-JOB（ADR-10：SnailJob 已整体下线） ----------------
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=PLEASE_CHANGE_XXL_JOB_ACCESS_TOKEN

# ---------------- Dify（外部研究编排，独立数据域，同机宿主端口 5001） ----------------
# Dify 是独立 Compose 项目（deploy/dify），核心服务经 host.docker.internal 访问；
# 若改为共网络部署，可换成 http://dify-api:5001
DIFY_BASE_URL=http://host.docker.internal:5001
# 在 Dify 控制台对应已发布 Workflow 应用的「API 访问」页面生成
DIFY_APP_API_KEY=PLEASE_CHANGE_DIFY_APP_API_KEY

# ---------------- TradingAgents（多智能体研究引擎，独立数据域，同机宿主端口 8000） ----------------
# TradingAgents 是独立 Compose 项目（deploy/tradingagents），核心服务经 host.docker.internal 访问；
# 若改为共网络部署，可换成 http://tradingagents:8000
TRADING_AGENTS_BASE_URL=http://host.docker.internal:8000
# 来自 TradingAgents-CN 自身 .env / 其管理后台发放的访问凭据
TRADING_AGENTS_API_KEY=PLEASE_CHANGE_TRADING_AGENTS_API_KEY

# ---------------- 数据源 ----------------
TUSHARE_TOKEN=PLEASE_CHANGE_TUSHARE_TOKEN

# ---------------- 宿主端口映射（按需调整避免冲突） ----------------
# 前端网关 nginx：默认占用宿主 80；被占用可改为 8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
XXL_JOB_ADMIN_PORT=8090

# =====================================================================
# 注意：前后端接口加密 RSA Key 必须成对更换（详见《详设_9》§12.3）
#   后端 api-decrypt.publicKey / privateKey（application.yml）
#   前端 VITE_APP_RSA_PUBLIC_KEY / VITE_APP_RSA_PRIVATE_KEY（plus-ui/.env.production）
#   更换时前后端必须同步，否则 nginx 侧传输的敏感业务数据无法加解密。
# =====================================================================