<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quantpf.domain.persistence.mapper.JobExecutionAuditMapper">
    <resultMap id="JobExecutionAuditRowMap" type="com.quantpf.domain.persistence.record.JobExecutionAuditRow">
        <id property="id" column="id" />
        <result property="jobName" column="job_name" />
        <result property="executionId" column="execution_id" />
        <result property="schedulerType" column="scheduler_type" />
        <result property="status" column="status" />
        <result property="requestId" column="request_id" />
        <result property="startedAt" column="started_at" />
        <result property="finishedAt" column="finished_at" />
        <result property="errorCode" column="error_code" />
        <result property="errorMessage" column="error_message" />
        <result property="createdAt" column="created_at" />
    </resultMap>
    <sql id="columns">id, job_name, execution_id, scheduler_type, status, request_id, started_at, finished_at, error_code, error_message, created_at</sql>
    <select id="selectPage" resultMap="JobExecutionAuditRowMap">
        SELECT <include refid="columns"/>
        FROM quantpf_job_execution_audit
        <where>
            <if test="jobName != null and jobName != ''">AND job_name = #{jobName}</if>
            <if test="executionId != null and executionId != ''">AND execution_id = #{executionId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY created_at DESC, id DESC
        LIMIT #{offset}, #{limit}
    </select>
</mapper>