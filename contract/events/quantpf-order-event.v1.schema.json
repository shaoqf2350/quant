{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantpf.local/schema/quantpf-order-event.v1.schema.json",
  "title": "QuantPF order Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "requestId",
    "aggregateType",
    "aggregateId",
    "schemaVersion",
    "source",
    "payload",
    "traceId",
    "idempotencyKey"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schemaVersion": {
      "type": "string",
      "const": "v1"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
